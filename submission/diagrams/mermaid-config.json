{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Arial, sans-serif",
    "fontSize": "16px",
    "primaryColor": "#eff6ff",
    "primaryTextColor": "#172b4d",
    "primaryBorderColor": "#4b74a5",
    "lineColor": "#52677d",
    "secondaryColor": "#f0fdf4",
    "tertiaryColor": "#f8fafc",
    "clusterBkg": "#f8fafc",
    "clusterBorder": "#94a3b8"
  },
  "flowchart": {
    "curve": "linear",
    "htmlLabels": false,
    "wrappingWidth": 240,
    "nodeSpacing": 30,
    "rankSpacing": 45
  },
  "sequence": {
    "useMaxWidth": false,
    "wrap": true
  }
}
