  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.14",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:nomenu": "EXPO_NO_DEV_MENU=1 expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test-db.json",
    "test": "npm run test:logic && npm run test:db",
    "test:logic": "jest",
    "test:db": "node --import tsx --test --test-concurrency=1 \"test-db/*.test.ts\"",
    "reset-project": "node ./scripts/reset-project.js"
  }
