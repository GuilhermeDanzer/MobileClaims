# Copy to .env and adjust. All values have working local defaults.
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgres://claims:claims@localhost:5432/claims

# Object storage (LocalStack S3 locally; S3 in production — same client, different endpoint)
STORAGE_ENDPOINT=http://localhost:4566
STORAGE_REGION=us-east-1
STORAGE_BUCKET=claims-documents
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ACCESS_KEY=test
STORAGE_SECRET_KEY=test

# local | test | production
APP_ENV=local

# dev = local JWT issuers (ADR-015); real = external OIDC issuers (not implemented)
AUTH_MODE=dev

LOG_LEVEL=info
