{
  "name": "northwind-mobile-claims",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "mobile": "npm --workspace @northwind/mobile run start",
    "mobile:ios": "npm --workspace @northwind/mobile run ios",
    "mobile:android": "npm --workspace @northwind/mobile run android",
    "api": "npm --workspace @northwind/api run dev",
    "worker": "npm --workspace @northwind/api run worker",
    "onprem": "npm --workspace @northwind/onprem-stub run dev",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "infra:up": "docker compose -f infra/local/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/local/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/local/docker-compose.yml logs -f"
  }
}
